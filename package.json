{
  "name": "workspace-gojo-satoru",
  "version": "2.0.0",
  "type": "module",
  "description": "Anime compilation pipeline — TS/Bun + SQLite + Python detector",
  "scripts": {
    "dev": "bun run src/main.ts",
    "cron": "bun run src/cron_run.ts",
    "discover": "bun run src/discover_jobs.ts",
    "bot": "bun run src/telegram_bot.ts",
    "typecheck": "bun run --check src/**/*.ts",
    "migrate": "bun run scripts/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
