{
  "defaults": {
    "output_dir": "./output",
    "watermark_path": "./assets/watermark.png",
    "skip_types": ["op", "ed"],
    "download": {
      "timeout_minutes_per_episode": 20,
      "timeout_minutes_minimum": 30,
      "timeout_minutes_maximum": 1440
    },
    "cleanup": {
      "downloads": true,
      "temp": true,
      "output": true
    },
    "timing_detection": {
      "enabled": true,
      "mode": "audio_fingerprint",
      "search_head_seconds": 300,
      "search_tail_seconds": 180,
      "min_support_episodes": 3,
      "frame_step_seconds": 0.25,
      "min_segment_seconds": 45,
      "max_segment_seconds": 150,
      "feature_sample_rate": 16000,
      "feature_hop_length": 4000,
      "consensus_min_similarity": 0.78,
      "pair_match_min_seconds": 35,
      "high_confidence_boundary_tolerance_seconds": 2.0,
      "analysis_audio_language": "jpn",
      "reference_core_trim_seconds": 10.0,
      "cache_enabled": true,
      "detector_version": "v2",
      "auto_cut_min_confidence": "high"
    },
    "timing_providers": {
      "anilibria_enabled": true,
      "aniskip_enabled": false
    },
    "delivery": {
      "s3_enabled": true,
      "s3_upload_video": false,
      "s3_upload_timestamps": false,
      "s3_upload_manifest": true,
      "vk_enabled": true,
      "vk_wall_post_enabled": true,
      "vk_comment_enabled": true,
      "vk_privacy_view": 0,
      "vk_preview_enabled": false,
      "vk_preview_mode": "video_thumb",
      "vk_preview_provider": "wavespeed",
      "vk_preview_model": "google/nano-banana-2/edit-fast",
      "vk_preview_timeout_seconds": 180,
      "vk_preview_prompt_template": "Transform the provided anime poster into a clickable VK video thumbnail. Keep the anime identity and main character recognizable. Use a bold, stylish, highly readable title treatment integrated into the artwork. Clean composition, high contrast, professional social-media look, 16:9, 1280x720, no extra logos, no unrelated text, no watermarks. Main text: \"{title_text}\". Secondary text: \"{episode_text}\".",
      "vk_preview_output_aspect_ratio": "16:9",
      "vk_preview_target_size": "1280x720",
      "vk_preview_temp_dir": "./temp/vk_preview",
      "vk_comment_banner_path": "./assets/banner.png",
      "vk_comment_template": "2202 2088 8598 1325 - Поддержать монетой (Сбер)❤️\n\nhttps://www.donationalerts.com/r/animemonstrs - Поддержать монетой (СБП)✨\n\nhttps://vk.com/donut/animonster - Платная подписка🔥"
    },
    "encoding": {
      "video_codec": "h264_nvenc",
      "preset": "fast",
      "cq": 23,
      "audio_codec": "aac"
    }
  },
  "upscale": {
    "video2x_path": "~/tools/video2x/6.4.0/Video2X-x86_64.AppImage",
    "appimage_extract_and_run": true
  },
  "automation": {
    "enabled": true,
    "provider": "aniliberty",
    "jobs_path": "./jobs.json",
    "completed_jobs_path": "./completed_jobs.json",
    "state_path": "./state.json",
    "poll_limit": 50,
    "download_root": "./downloads",
    "default_source_type": "magnet"
  }
}
